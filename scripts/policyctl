#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
POLICY_FILE="${CUSIMANSE_POLICY_FILE:-$ROOT/policies/host-policy.yaml}"
AUDIT_FILE="${CUSIMANSE_POLICY_AUDIT:-$ROOT/runs/policy-decisions.jsonl}"

usage() {
  cat <<'EOF'
policyctl — Cusimanse policy control and enforcement

Usage:
  scripts/policyctl show [--file FILE]
  scripts/policyctl explain ACTION [--file FILE] [--json]
  scripts/policyctl validate [--file FILE]
  scripts/policyctl check ACTION [--file FILE] [--audit FILE] [--json]
  scripts/policyctl check-all [--file FILE] [--audit FILE] [--json]
  scripts/policyctl require ACTION [--file FILE] [--audit FILE] [--approved]
  scripts/policyctl enforce ACTION [--file FILE] [--audit FILE] [--approved]
  scripts/policyctl audit [--file FILE]

Operator flow:
  1. validate the declarative policy;
  2. explain/check each capability needed by the operation;
  3. require approval for approval-required actions;
  4. enforce the decision at the Go capability boundary;
  5. inspect the audit stream after the operation.

Actions:
  credentials       host credentials access
  mounts            unrestricted host mounts
  host-root         host filesystem access
  sudo              privileged sudo
  vm                disposable VM creation
  lima              Lima virtualization
  qemu              QEMU virtualization
  network           localhost service access
  public-mcp        public MCP access
  public-gateway    public gateway access
  git-read          repository read
  git-write         repository write
  push              git push
  learning          learning helpers
  host-execution    untrusted host execution
  network-reconfig  host network reconfiguration

Exit codes for require/enforce:
  0 allowed
  3 approval required but not approved
  4 denied
  2 invalid/unknown action or policy
EOF
}

need_yq() { command -v yq >/dev/null 2>&1 || { echo "policyctl: yq is required" >&2; exit 2; }; }

policy_value() {
  local action="${1,,}"
  case "$action" in
    credentials) yq -r '.host.credentials // ""' "$POLICY_FILE" ;;
    mounts|host-mounts) yq -r '.host.unrestricted_mounts // ""' "$POLICY_FILE" ;;
    host-root|host-filesystem) yq -r '.privileged.host_filesystem // ""' "$POLICY_FILE" ;;
    sudo) yq -r '.privileged.sudo // ""' "$POLICY_FILE" ;;
    vm|disposable-vm) yq -r '.virtualization.disposable_vm // ""' "$POLICY_FILE" ;;
    lima) yq -r '.virtualization.lima // ""' "$POLICY_FILE" ;;
    qemu) yq -r '.virtualization.qemu // ""' "$POLICY_FILE" ;;
    network|localhost-network|localhost-services) yq -r '.network.localhost_services // ""' "$POLICY_FILE" ;;
    public-mcp) yq -r '.network.public_mcp // ""' "$POLICY_FILE" ;;
    public-gateway) yq -r '.network.public_gateway // ""' "$POLICY_FILE" ;;
    git-read|read) yq -r '.git.read // ""' "$POLICY_FILE" ;;
    git-write|write) yq -r '.git.write // ""' "$POLICY_FILE" ;;
    push) yq -r '.git.push // ""' "$POLICY_FILE" ;;
    learning|learning-helpers) yq -r '.orchestration.learning_helpers // ""' "$POLICY_FILE" ;;
    host-execution|untrusted-host-execution) yq -r '.host.untrusted_host_execution // ""' "$POLICY_FILE" ;;
    network-reconfig|network-reconfiguration) yq -r '.privileged.network_reconfiguration // ""' "$POLICY_FILE" ;;
    *) return 2 ;;
  esac
}

record() {
  local action="$1" decision="$2"
  mkdir -p "$(dirname "$AUDIT_FILE")"
  printf '{"action":"%s","decision":"%s","policy_file":"%s","timestamp":"%s"}\n' \
    "$action" "$decision" "$POLICY_FILE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$AUDIT_FILE"
}

show() { need_yq; yq -P '.' "$POLICY_FILE"; }

validate() {
  need_yq
  [ -r "$POLICY_FILE" ] || { echo "policyctl: missing policy: $POLICY_FILE" >&2; exit 2; }
  local version
  version="$(yq -r '.version // 0' "$POLICY_FILE")"
  [[ "$version" =~ ^[0-9]+$ && "$version" -gt 0 ]] || { echo 'policyctl: policy version is required' >&2; exit 2; }
  local required
  for required in '.host.credentials' '.host.unrestricted_mounts' '.host.untrusted_host_execution' '.privileged.sudo' '.privileged.host_filesystem' '.virtualization.disposable_vm' '.network.public_mcp' '.network.public_gateway' '.network.localhost_services' '.git.read' '.git.write' '.git.push' '.orchestration.learning_helpers' '.evidence.preserve_before_destroy' '.evidence.hashing'; do
    [ "$(yq -r "$required // \"\"" "$POLICY_FILE")" != "" ] || { echo "policyctl: missing $required" >&2; exit 2; }
  done
  echo "PASS policy $POLICY_FILE (version $version)"
}

explain() {
  need_yq
  local action="$1" decision
  validate >/dev/null
  if ! decision="$(policy_value "$action")"; then echo "policyctl: unknown action: $action" >&2; exit 2; fi
  [ -n "$decision" ] || { echo "policyctl: no policy value for: $action" >&2; exit 2; }
  case "$decision" in
    allow|allowed|controlled|required) guidance="The capability may proceed within the declared boundary." ;;
    approval-required|approval_required|approval) guidance="Stop before the gated action and obtain explicit researcher approval." ;;
    deny|denied) guidance="The capability is prohibited; do not bypass or substitute an equivalent host action." ;;
    *) guidance="Policy decision is defined but not supported by this operator helper." ;;
  esac
  printf '%s: decision=%s; %s\n' "$action" "$decision" "$guidance"
}

check() {
  need_yq
  local action="$1" json_out="${2:-1}" decision
  validate >/dev/null
  if ! decision="$(policy_value "$action")"; then
    echo "policyctl: unknown action: $action" >&2; exit 2
  fi
  [ -n "$decision" ] || { echo "policyctl: no policy value for: $action" >&2; exit 2; }
  record "$action" "$decision"
  if [ "$json_out" = 1 ]; then
    printf '{"action":"%s","decision":"%s","policy_file":"%s","timestamp":"%s"}\n' \
      "$action" "$decision" "$POLICY_FILE" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  else
    printf '%s: %s\n' "$action" "$decision"
  fi
}

check_all() {
  need_yq
  validate >/dev/null
  local actions=(credentials mounts vm network git-write public-mcp public-gateway host-execution network-reconfig)
  local action decision
  for action in "${actions[@]}"; do
    decision="$(policy_value "$action")" || exit 2
    [ -n "$decision" ] || { echo "policyctl: no policy value for: $action" >&2; exit 2; }
    record "$action" "$decision"
    printf '%s: %s\n' "$action" "$decision"
  done
}

require_or_enforce() {
  local action="$1" approved="$2" decision
  validate >/dev/null
  if ! decision="$(policy_value "$action")"; then echo "policyctl: unknown action: $action" >&2; exit 2; fi
  [ -n "$decision" ] || { echo "policyctl: no policy value for: $action" >&2; exit 2; }
  record "$action" "$decision"
  case "$decision" in
    allow|allowed|controlled) echo "ALLOW $action ($decision)"; return 0 ;;
    deny|denied) echo "DENY $action ($decision)" >&2; return 4 ;;
    approval-required|approval_required|approval)
      if [ "$approved" = 1 ]; then echo "ALLOW $action (approved; policy=$decision)"; return 0; fi
      echo "APPROVAL REQUIRED $action" >&2; return 3 ;;
    required) echo "ALLOW $action (required)"; return 0 ;;
    *) echo "policyctl: unsupported decision '$decision' for $action" >&2; return 2 ;;
  esac
}

audit() {
  if [ -f "$AUDIT_FILE" ]; then cat "$AUDIT_FILE"; else echo "No policy decisions recorded: $AUDIT_FILE"; fi
}

main() {
  local command="${1:-help}"; shift || true
  local action='' approved=0 json=1
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --file) POLICY_FILE="$2"; shift 2 ;;
      --audit|--audit-file) AUDIT_FILE="$2"; shift 2 ;;
      --action) action="$2"; shift 2 ;;
      --approved|--approve) approved=1; shift ;;
      --json) json=1; shift ;;
      --text|--no-json) json=0; shift ;;
      -h|--help) usage; return 0 ;;
      *) [ -z "$action" ] && action="$1" || { echo "policyctl: unexpected argument: $1" >&2; exit 2; }; shift ;;
    esac
  done
  case "$command" in
    show) show ;;
    explain) [ -n "$action" ] || { echo 'policyctl: explain requires ACTION' >&2; exit 2; }; explain "$action" ;;
    validate) validate ;;
    check) [ -n "$action" ] || { echo 'policyctl: check requires ACTION' >&2; exit 2; }; check "$action" "$json" ;;
    check-all) check_all ;;
    require|enforce) [ -n "$action" ] || { echo "policyctl: $command requires ACTION" >&2; exit 2; }; require_or_enforce "$action" "$approved" ;;
    audit) audit ;;
    help) usage ;;
    *) echo "policyctl: unknown command: $command" >&2; usage; exit 2 ;;
  esac
}

main "$@"
