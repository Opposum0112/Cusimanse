{
  "manifest_version": 3,
  "package": "Cusimanse",
  "license": "MIT",
  "spdx": "MIT",
  "architecture": {
    "operator_model": "primary-agent-shell",
    "shell_driven": true,
    "orchestration_owner": "selected-primary-agent-shell",
    "execution_owner": "selected-primary-agent-shell",
    "lifecycle_owner": "selected-primary-agent-shell",
    "security_boundary": "disposable-lima-qemu-vm-and-os-controls",
    "host_scripts_role": "bootstrap-validation-preflight-only"
  },
  "primary_agent_contracts": [
    "recipes/agents/primary-agent.yaml",
    "recipes/agents/primary-shell.yaml",
    "recipes/agents/learning-loop.yaml",
    "recipes/agents/adapter-matrix.yaml",
    "recipes/agent-selection.yaml"
  ],
  "adapter_contracts": [
    "recipes/adapters/goose.yaml",
    "recipes/adapters/opencode.yaml",
    "recipes/adapters/grok-build.yaml",
    "recipes/adapters/antigravity.yaml",
    "recipes/adapters/pi.yaml",
    "recipes/adapters/hermes.yaml",
    "recipes/adapters/codex.yaml",
    "recipes/adapters/prime-intellect.yaml",
    "recipes/adapters/claude-code.yaml",
    "recipes/adapters/devin.yaml"
  ],
  "runtime_documentation": [
    "README.md",
    "contracts/01-deployment-architecture.md",
    "docs/agent-shell-runbook.md",
    "docs/agent-and-adapter-strategy.md",
    "contracts/03-deployment-runbook.md",
    "contracts/10-validation-and-acceptance.md"
  ],
  "runtime_validation": {
    "bootstrap": "scripts/prerequisites.sh",
    "preflight": "scripts/agent-preflight.sh",
    "repository_validation": "scripts/tests/validate-project.sh",
    "policy_validation": "policyctl validate",
    "reference_experiment": "experiments/go-install-001"
  },
  "shell_forms": {
    "goose": {"interactive": "goose", "run": "goose run --text '<PROMPT>'"},
    "opencode": {"interactive": "opencode", "run": "opencode run '<PROMPT>'"},
    "grok-build": {"interactive": "grok", "run": "grok -p '<PROMPT>'"},
    "antigravity": {"interactive": "agy", "run": "verify with agy --help"},
    "pi": {"interactive": "pi", "run": "pi -p '<PROMPT>'"},
    "hermes": {"interactive": "hermes", "run": "TUI-first; use the installed Hermes interactive prompt flow"},
    "codex": {"interactive": "codex", "run": "verify with codex --help"},
    "prime-intellect": {"interactive": "prime-agent", "run": "prime-agent -p '<PROMPT>'"},
    "claude-code": {"interactive": "claude", "run": "verify with claude --help"},
    "devin": {"interactive": "provider-managed", "run": "provider-managed"}
  },
  "acceptance": {
    "PASS": "runtime evidence plus required independent verification",
    "PARTIAL": "incomplete required coverage",
    "FAIL": "contract or safety violation",
    "NOT_DEPLOYED": "provider/runtime/configuration unavailable or unverified"
  },
  "manifest_note": "Manifest is an architecture/runtime inventory, not runtime evidence. Provider CLI versions and commands must be verified by preflight; complete disposable-VM execution is required for runtime PASS."
}
