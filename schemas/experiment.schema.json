{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cusimanse.dev/schemas/experiment.json",
  "title": "Cusimanse Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "cusimanse.dev/v1" },
    "kind": { "const": "Experiment" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "hostPrep", "roles", "scope", "requirements", "policyChecks", "acceptance", "operator"],
      "properties": {
        "question": { "type": "string", "minLength": 8 },
        "hostPrep": { "enum": ["default", "none"] },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["operator", "verifier", "reporter"] }
        },
        "scope": {
          "type": "object",
          "required": ["exclude"],
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["execution", "os", "workload", "network", "instrumentation"],
          "properties": {
            "execution": { "enum": ["disposable"] },
            "os": { "enum": ["linux", "macos"] },
            "workload": { "enum": ["npm-install", "npm-lifecycle", "npm-threat", "go-install"] },
            "network": { "enum": ["localhost-only", "none", "controlled"] },
            "instrumentation": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["process", "syscall", "filesystem", "network"] }
            }
          }
        },
        "policyChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["vm", "network", "credentials", "mounts"] }
        },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "operator": { "enum": ["goose", "cli"] },
        "observability": {
          "type": "object",
          "properties": {
            "host": { "type": "array", "items": { "type": "string" } },
            "experiment": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
