{
  "name": "@cusimanse/agent-runtime",
  "version": "0.4.0",
  "description": "Harness-neutral declarative and agentic security research runtime",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "cusimanse": "./dist/bin/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./gateway": { "types": "./dist/gateway/server.d.ts", "import": "./dist/gateway/server.js" } },
  "files": ["dist", "recipes", "labs", "skills", "schema", "README.md"],
  "scripts": { "build": "tsc", "watch": "tsc --watch", "check-types": "tsc --noEmit", "lint": "eslint . --max-warnings=0", "test": "vitest run", "test:coverage": "vitest run --coverage", "cli": "node dist/bin/cli.js" },
  "dependencies": { "@ai-sdk/anthropic": "^4.0.0", "@ai-sdk/google": "^4.0.0", "@ai-sdk/openai": "^4.0.0", "ai": "^7.0.0", "commander": "^14.0.0", "yaml": "^2.8.1", "zod": "^4.1.8" },
  "devDependencies": { "@eslint/js": "^9.35.0", "@types/node": ">=22.0.0", "@vitest/coverage-v8": "^3.2.4", "eslint": "^9.35.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "typescript-eslint": "^8.43.0", "vitest": "^3.2.4" }
}
