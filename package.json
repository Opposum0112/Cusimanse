{
  "name": "@cusimanse/agent-runtime",
  "version": "0.2.0",
  "description": "Harness-neutral research-contract runtime for agent-operated security labs",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./gateway": {
      "types": "./dist/src/gateway/server.d.ts",
      "import": "./dist/src/gateway/server.js"
    }
  },
  "files": [
    "dist/src",
    "recipes",
    "labs",
    "skills",
    "schema",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
