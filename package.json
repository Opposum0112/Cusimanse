{
  "name": "@cusimanse/agent-runtime",
  "version": "0.3.0",
  "description": "Harness-neutral, composable threat-research platform for isolated agentic security experiments",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "cusimanse": "./dist/bin/cli.js" },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./gateway": { "types": "./dist/src/gateway/server.d.ts", "import": "./dist/src/gateway/server.js" }
  },
  "files": ["dist", "recipes", "labs", "skills", "schema", "README.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "cli": "npm run build && node dist/bin/cli.js",
    "lab:npm-install": "npm run build && node dist/src/bin/serve-npm-install-lab.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/workflow": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "ai": "^7.0.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
