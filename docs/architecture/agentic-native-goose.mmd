flowchart TB
  researcher[Researcher]
  yaml[experiments/*.yaml]
  schema[schemas/cusimanse.yaml]
  goose[Goose session recipe]
  roles[roles + skills registry]
  prep[host-prep/default.yaml]
  compile[cmd/compile]
  engine[cusimanse run]
  vm[Lima or Multipass guest]
  runs[runs/session]
  gw[LiteLLM / OmniRoute]
  obs[ClawMetry / Numbat / Goose logs]

  researcher --> yaml
  schema --> yaml
  yaml --> goose
  roles --> goose
  gw -.-> goose
  goose -->|validate host-prep resolve execute| compile
  prep --> compile
  compile -->|approved| engine
  engine --> vm
  vm --> runs
  goose --> runs
  obs -.-> goose
  obs -.-> runs
