{
  "manifest_version": 28,
  "branch_scope": "goose-native",
  "source_of_truth": {
    "contracts": "contracts/",
    "experiments": "recipes/experiments/*.yaml",
    "linkml_schema": "schemas/cusimanse.yaml",
    "capability_registry": "recipes/profiles/registry.yaml",
    "go_cli": "cmd/cusimanse/",
    "go_runtime_packages": ["internal/model/", "internal/policy/", "internal/preflight/", "internal/validation/", "internal/execution/", "internal/runtime/"],
    "role_skill_registry": "recipes/agents/role-skill-registry.json",
    "goose_recipe": "recipes/goose/session.yaml",
    "goose_subrecipes": "recipes/subrecipes/*.yaml",
    "session_state": "recipes/session/session-state.yaml",
    "learning": "recipes/session/learning-workflow.yaml",
    "skills_registry": "recipes/skills/registry.yaml",
    "mcp": "recipes/mcp/registry.yaml",
    "adapters": "recipes/agents/adapter-matrix.yaml",
    "agent_orchestration": "recipes/agents/goose-orchestration.yaml",
    "prompts_experiments": "prompts/experiments/",
    "prompts_operator_guides": "prompts/operators/",
    "host": "recipes/host/security-research.yaml",
    "tool_inventory": "manifest/TOOL-INVENTORY.yaml",
    "gateway": "recipes/gateway/mandatory.yaml",
    "observability": "recipes/observability/mandatory.yaml",
    "instrumentation": "recipes/instrumentation/security-research.yaml",
    "policy": "policies/host-policy.yaml",
    "research_outputs": "runs/<session-id>/",
    "researcher_runbook": "docs/RESEARCHER-GUIDE.md",
    "instrumentation_guide": "docs/INSTRUMENTATION.md",
    "hygiene_guide": "docs/REPO-HYGIENE.md"
  },
  "reference_operator": "goose",
  "execution_boundary": "Lima/QEMU + guest OS",
  "go_entrypoint": "cmd/cusimanse",
  "legacy_removed": ["cmd/compile", "internal/compiler"],
  "gateway": {"recipe": "recipes/gateway/mandatory.yaml", "routing": "OmniRoute@3.8.50", "model_gateway": "LiteLLM", "localhost_only": true, "secrets_externalized": true},
  "instrumentation": {"recipe": "recipes/instrumentation/security-research.yaml", "scope": "disposable-lima-vm", "guide": "docs/INSTRUMENTATION.md", "collectors_start_before_workload": true, "raw_evidence_immutable": true, "model_output_is_evidence": false},
  "host_toolchain": {"recipe": "recipes/host/security-research.yaml", "inventory": "manifest/TOOL-INVENTORY.yaml", "inventory_command": "cusimanse capability list", "config_command": "cusimanse tools config"},
  "validation": {"implementation": "native Go packages", "bootstrap": "scripts/install.sh", "validation": "scripts/tests/validate.sh", "runtime": "scripts/tests/runtime.sh", "integration": "scripts/tests/integration.sh", "goose_recipe": "goose recipe validate recipes/goose/session.yaml", "ci_does_not_require_lima": true}
}
