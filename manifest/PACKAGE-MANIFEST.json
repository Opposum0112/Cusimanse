{
  "manifest_version": 29,
  "branch_scope": "goose-native",
  "source_of_truth": {
    "linkml_schema": "schemas/cusimanse.yaml",
    "experiment_instances": "experiments/*.yaml",
    "runtime_experiments": "recipes/experiments/*.yaml",
    "capability_registry": "recipes/profiles/registry.yaml",
    "go_cli": "cmd/cusimanse/",
    "go_runtime_packages": [
      "internal/model/",
      "internal/policy/",
      "internal/preflight/",
      "internal/validation/"
    ],
    "goose_session_recipe": "recipes/goose/session.yaml",
    "goose_experiment_recipe": "recipes/<id>/recipe.yaml",
    "goose_subrecipes": "recipes/subrecipes/*.yaml",
    "host_prep": "host-prep/default.yaml",
    "tool_inventory": "manifest/TOOL-INVENTORY.yaml",
    "policy": "policies/host-policy.yaml",
    "research_outputs": "runs/<session-id>/",
    "research_report": "runs/<session-id>/research-report/",
    "researcher_runbook": "README.md"
  },
  "reference_operator": "goose",
  "execution_boundary": "Lima/QEMU + guest OS",
  "go_entrypoint": "cmd/cusimanse",
  "legacy_removed": ["retired-compiler-cli", "unused-execution-package", "unused-runtime-package"],
  "validation": {
    "implementation": "native Go packages",
    "bootstrap": "scripts/install.sh",
    "validation": "scripts/tests/validate.sh",
    "runtime": "scripts/tests/runtime.sh",
    "integration": "scripts/tests/integration.sh",
    "goose_session": "goose recipe validate recipes/goose/session.yaml",
    "goose_experiment": "goose recipe validate recipes/npm-install-001/recipe.yaml",
    "ci_does_not_require_lima": true
  }
}
