{
  "manifest_version": 9,
  "branch": "goose-refactor",
  "source_of_truth": {
    "contracts": "contracts/",
    "goose_recipes": "recipes/*/recipe.yaml",
    "experiments": "recipes/experiments/*.yaml",
    "session_state": "recipes/session/session-state.yaml",
    "prompts": "prompts/experiments/",
    "roles": ".agents/agents/",
    "skills": "recipes/skills/registry.yaml",
    "mcp": "recipes/mcp/registry.yaml",
    "adapters": "recipes/agents/adapter-matrix.yaml",
    "host": "recipes/host/security-research.yaml"
  },
  "reference_operator": "goose",
  "primary_agents": ["goose", "opencode", "hermes", "antigravity", "pi"],
  "experiments": {
    "go-install-001": {
      "goose_recipe": "recipes/go-install-001/recipe.yaml",
      "configuration": "recipes/experiments/go-install-001.yaml",
      "contract": "contracts/go-install-001.md",
      "prompt": "prompts/experiments/go-install-001.md"
    },
    "npm-install-001": {
      "goose_recipe": "recipes/npm-install-001/recipe.yaml",
      "configuration": "recipes/experiments/npm-install-001.yaml",
      "contract": "contracts/npm-install-001.md",
      "prompt": "prompts/experiments/npm-install-001.md"
    }
  },
  "host": {
    "inventory": "recipes/host/security-research.yaml",
    "installer": "scripts/install.sh",
    "windows_installer": "scripts/install.ps1",
    "access": "scripts/tools.sh",
    "preflight": "scripts/preflight.sh",
    "session_helper": "scripts/session.sh",
    "idempotent": true,
    "platforms": ["linux", "macos", "windows-wsl2"]
  },
  "mandatory_host_services": {
    "gateways": "recipes/gateway/mandatory.yaml",
    "observability": "recipes/observability/mandatory.yaml"
  },
  "goose_native": ["recipes", "subrecipes", "Summon", "Skills", "MCP/extensions", "native delegation"],
  "external_skill_registry": "https://github.com/mukul975/Anthropic-Cybersecurity-Skills",
  "execution_boundary": "Lima/QEMU + guest OS",
  "container": "optional",
  "learning": {
    "recipe": "recipes/session/learning-workflow.yaml",
    "default_enabled": false,
    "candidate_library": "skills/candidate/",
    "validated_library": "skills/validated/",
    "human_approval_required": true
  },
  "validation": {
    "static": "scripts/tests/validate.sh",
    "runtime": "scripts/tests/runtime.sh",
    "runtime_pass_requires": ["actual disposable VM execution", "independent verification"],
    "ci_does_not_require_lima": true
  }
}
